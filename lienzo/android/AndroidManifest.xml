<?xml version="1.0" encoding="utf-8"?>
<!-- Manifiesto del App Bundle para Google Play. versionCode y versionName
     los rellena tools/android_aab.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sesolibre.lienzo"
    android:versionCode="VERSION_CODE"
    android:versionName="VERSION_NAME">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:allowBackup="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="lienzo_app"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
